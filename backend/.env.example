# Server Configuration
PORT=3001
NODE_ENV=development

# CORS Configuration
# Which origins the API answers. Comma-separated: more than one thing is the
# app now. The dev server is on :4200; the packaged Android build serves its
# own pages from http://localhost with no port, which is a different origin and
# is refused by a setting that names only the browser.
CORS_ORIGIN=http://localhost:4200,http://localhost

# Database Configuration
#
# The synced cache: categories, streams, guide data, favourites and manual
# ordering. Relative paths are resolved against the backend package, not the
# working directory, so this names the same file however the server is started.
# The directory is created if it does not exist.
#
# Pointing this at a different file starts from an empty cache and needs a
# fresh sync; the old file is left alone, so switching back restores it.
#
# On a server, name an absolute path on a volume that outlives a deploy, e.g.
# /data/xtream-cache.db. A relative path is resolved against the backend
# package, which for a compiled build is the output directory -- so the setting
# below means a different file in production than it does here, and the next
# deploy replaces it along with the accounts and subscriptions inside. The
# server prints the path it resolved on startup.
DATABASE_PATH=./xtream-cache.db

# Accounts.
#
# You sign in with a username and password of your own, and your subscription
# is stored against that account rather than being the account. Xtream
# credentials expire and get reissued; when that happens you re-enter them and
# your favourites, arranging and history stay where they are.
#
# Registration is open by default so the first account can be made. On anything
# reachable beyond your own machine, close it once you have yours:
#   open        anyone can create an account (default)
#   first-only  open until exactly one account exists, then closed
#   closed      no new accounts
ACCOUNT_REGISTRATION=open

# Encrypts stored Xtream passwords at rest, so a copy of the database is not a
# copy of every subscription. 32 bytes, base64 or hex.
#
# Leave it blank and one is generated beside the database on first run. Losing
# the key means re-entering subscriptions -- nothing you have made is lost with
# it. Setting it explicitly is the way to keep one key across machines.
#
# This guards the database file, not the machine: the key sits next to it. The
# stronger arrangement, where the key comes from your account password and the
# server cannot read the secrets at all, needs the provider calls to happen on
# your own device.
CREDENTIAL_KEY=

# The secret behind the salts handed out for names with no account.
#
# Signing in needs a salt before the password can be turned into anything, so
# the endpoint that hands salts out cannot sit behind a session. Answering "no
# such user" would make it a list of who has an account here, so an unknown
# name gets a salt made from this secret and the name instead -- the same every
# time, and indistinguishable from a real one.
#
# Generated beside the database if left blank. Losing it is harmless: real
# accounts carry their own salts, and only the disguises change.
ACCOUNT_SALT_SECRET=

# Xtream API Configuration
XTREAM_BASE_URL=http://your-xtream-server.com/player_api.php

# XTREAM_USERNAME and XTREAM_PASSWORD used to be here and are gone. Your
# subscription is stored against your account, encrypted, and entered through
# the app. Nothing reads them, and a provider password sitting in a file in
# plaintext for no purpose is worth deleting rather than documenting.

# Sync.
#
# A sync asks the provider for streams one category at a time, so the
# concurrency below is how many requests are in flight at once. Set it too high
# and the provider times them out; a category that times out is stored empty and
# then loads from the provider on every visit until the next sync.
#
# The default of 20 timed out on hundreds of categories against a real provider,
# and the volume of retries that followed got the address blocked outright.
# Raise this only if yours keeps up, and expect a block to be the price if it
# does not. A sync now gives up after two consecutive batches fail entirely,
# rather than working through every remaining category being refused.
SYNC_CONCURRENCY=5
# A slow answer is still worth having; giving up early is what empties a category.
SYNC_REQUEST_TIMEOUT_MS=45000
# Extra attempts for a category that failed, before the run writes it off.
SYNC_RETRIES=1
SYNC_BATCH_DELAY_MS=250

# Background EPG top-up.
#
# Xtream serves the guide one channel at a time, so filling it is a slow
# trickle rather than a single fetch. Every 30 minutes the server refreshes a
# batch of channels whose guide has run out, favourites first, and leaves the
# rest for later passes. It only runs when the credentials above are set,
# because the scheduler has no request to borrow credentials from.
#
# Raise the batch to fill faster; lower it if your provider objects to the
# request rate. Each channel in a batch is one request.
#
# The default is deliberately gentle. Sweeping every channel once takes
# roughly (channels / batch) * 30 minutes: with 4,500 channels and a batch of
# 40 that is about two days, with a batch of 200 about eleven hours. Expect
# only a minority of channels to return anything -- most providers publish a
# guide for a fraction of their line-up.
EPG_AUTO_REFRESH=true
EPG_REFRESH_BATCH=40
EPG_REFRESH_DELAY_MS=250
# A channel is left alone while its guide still reaches this many hours ahead.
EPG_FRESH_HOURS=6
# How long before a channel is asked again. Channels the provider has nothing
# for are remembered too, so a barren channel does not hold up the queue.
EPG_RETRY_HOURS=12

# How many proxies stand in front of this process.
#
# Unset means none, which is right on your own machine. Behind anything that
# terminates TLS and forwards -- Cloudflare, a load balancer, an nginx -- the
# connection belongs to that proxy, so without this every caller is counted as
# the same address and shares one rate limit between them.
#
# A count, because X-Forwarded-For is a header the caller can write and each
# hop appends to: trusting the whole of it would let anyone claim any address
# and step around the limit by inventing a new one per request. Count only the
# hops you actually put there.
#
#   1  Cloudflare, or any single proxy, straight through to this process
#   2  a proxy behind that, e.g. Cloudflare in front of your own nginx
#
# Addresses or CIDR ranges also work, if the proxy is at a known address.
TRUST_PROXY=

# Rate limiting.
#
# A guard against a runaway client, not against a busy one. One person watching
# one thing already costs about ninety requests a quarter of an hour -- a resume
# point is written every ten seconds -- before any browsing, guide lookups or
# favourites. The old ceiling of 100 was below that, and playback stopped with
# 429s partway through. Lower it only if the server is reachable from somewhere
# you do not control, and expect normal use to hit it if you go far below this.
RATE_LIMIT_WINDOW_MS=900000   # 15 minutes
RATE_LIMIT_MAX_REQUESTS=1000  # Max requests per window per IP

# Logging
LOG_LEVEL=info

# Session (if using sessions)
# SESSION_SECRET=your-session-secret
# SESSION_MAX_AGE=86400000  # 24 hours

# SSL/TLS (for production)
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem
# HTTPS_PORT=443

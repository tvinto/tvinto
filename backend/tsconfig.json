{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "../",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "types": ["node"],
    "baseUrl": "../",
    "paths": {
      "@shared/*": ["shared/*"]
    }
  },
  "include": ["src/**/*.ts", "../shared/**/*.ts"],
  // Tests and their helpers are compiled by ts-jest against tsconfig.test.json,
  // which adds the jest globals; they have no place in the shipped build.
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.test.ts",
    "src/test-utils",
    "../shared/**/*.test.ts"
  ]
}

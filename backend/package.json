{
  "name": "iptv-xtream-backend",
  "version": "1.0.0",
  "license": "GPL-3.0-only",
  "description": "Backend for IPTV Xtream Codes loader",
  "main": "dist/backend/src/server.js",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/server.ts",
    "start:prod": "node dist/backend/src/server.js",
    "dev": "tsx watch src/server.ts",
    "dev:old": "nodemon src/server.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:ci": "eslint . --max-warnings 0",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "prestart": "npm run build"
  },
  "dependencies": {
    "@types/compression": "^1.7.6",
    "@types/express-rate-limit": "^5.1.3",
    "@types/helmet": "^4.0.0",
    "@types/rate-limit-redis": "^1.6.5",
    "axios": "^1.6.2",
    "better-sqlite3": "^13.0.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "fast-xml-parser": "^4.3.2",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "rate-limit-redis": "^4.1.1",
    "rimraf": "^6.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@jest/globals": "^29.7.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/compression": "^1.7.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^5.1.3",
    "@types/helmet": "^4.0.0",
    "@types/jest": "^29.5.11",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.10.5",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.1.3",
    "globals": "^17.9.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.2.5",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/../shared",
      "<rootDir>/../worker",
      "<rootDir>/../cli/src"
    ],
    "testMatch": [
      "<rootDir>/src/**/*.test.ts",
      "<rootDir>/../shared/**/*.test.ts",
      "<rootDir>/../worker/**/*.test.ts",
      "<rootDir>/../cli/src/**/*.test.ts"
    ],
    "modulePaths": [
      "<rootDir>/node_modules"
    ],
    "globalSetup": "<rootDir>/src/test-utils/globalSetup.ts",
    "globalTeardown": "<rootDir>/src/test-utils/globalTeardown.ts",
    "setupFiles": [
      "<rootDir>/src/test-utils/jest.env.ts"
    ],
    "transform": {
      "^.+\\.(ts|tsx)$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/tsconfig.test.json"
        }
      ]
    },
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "../shared/**/*.ts",
      "!../shared/**/*.test.ts",
      "!src/**/*.d.ts",
      "!src/**/*.test.ts",
      "!src/test-utils/**",
      "!src/server.ts",
      "!src/app.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "coverageReporters": [
      "json",
      "lcov",
      "text",
      "clover"
    ]
  }
}

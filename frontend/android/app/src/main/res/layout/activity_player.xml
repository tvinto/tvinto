<?xml version="1.0" encoding="utf-8"?>
<!--
  The player, filling the screen and nothing else on it.

  Black rather than transparent: a stream whose picture is narrower than the
  panel is letterboxed, and letterboxing onto whatever was behind looks like a
  rendering fault.

  show_buffering="when_playing" gives the spinner Media3 draws itself, so a
  channel that is slow to start looks like it is starting rather than like it
  has failed.

  show_subtitle_button, because Media3 leaves it off by default and it was the
  only way to choose subtitles on Android: without it a film with subtitles
  could not have them turned on at all. The choice is reported back and
  remembered against the film (PlayerActivity.publishTracks).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        app:resize_mode="fit"
        app:show_buffering="when_playing"
        app:show_subtitle_button="true"
        app:use_controller="true" />

</FrameLayout>

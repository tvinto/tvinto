{
  "name": "Tvinto",
  "version": "1.0.129",
  "description": "Tvinto on the desktop",
  "author": {
    "name": "Tvinto contributors"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "license": "GPL-3.0-only",
  "main": "build/src/index.js",
  "scripts": {
    "build": "node scripts/copy-shared.js && tsc",
    "electron:start-live": "node ./live-runner.js",
    "electron:start": "npm run build && electron --inspect=5858 ./",
    "build:cli": "node ./scripts/build-cli.js",
    "electron:pack": "npm run build:cli && npm run build && electron-builder build --dir -c ./electron-builder.config.js",
    "fetch:mpv": "node ./scripts/fetch-mpv.js",
    "electron:make": "npm run fetch:mpv && npm run build:player && npm run build:cli && npm run build && electron-builder build -c ./electron-builder.config.js --publish never",
    "electron:publish": "node ./scripts/publish-update.js",
    "build:player": "node ./scripts/build-player.js"
  },
  "dependencies": {
    "@capacitor-community/electron": "^5.0.0",
    "@sentry/electron": "8.4.0",
    "chokidar": "~3.5.3",
    "electron-is-dev": "~2.0.0",
    "electron-serve": "~1.1.0",
    "electron-unhandled": "~4.0.1",
    "electron-updater": "^6.8.11",
    "electron-window-state": "^5.0.3",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "~26.18.0",
    "typescript": "^5.0.4"
  },
  "keywords": [
    "capacitor",
    "electron"
  ],
  "allowScripts": {
    "electron@45.3.2": true
  }
}

{
  "name": "Tvinto",
  "version": "1.0.127",
  "description": "Tvinto on the desktop",
  "author": {
    "name": "Tvinto contributors"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "license": "GPL-3.0-only",
  "main": "build/src/index.js",
  "scripts": {
    "build": "tsc && electron-rebuild",
    "electron:start-live": "node ./live-runner.js",
    "electron:start": "npm run build && electron --inspect=5858 ./",
    "electron:pack": "npm run build && electron-builder build --dir -c ./electron-builder.config.js",
    "fetch:mpv": "node ./scripts/fetch-mpv.js",
    "electron:make": "npm run fetch:mpv && npm run build && electron-builder build -c ./electron-builder.config.js --publish never",
    "electron:publish": "node ./scripts/publish-update.js"
  },
  "dependencies": {
    "@capacitor-community/electron": "^5.0.0",
    "chokidar": "~3.5.3",
    "electron-is-dev": "~2.0.0",
    "electron-serve": "~1.1.0",
    "electron-unhandled": "~4.0.1",
    "electron-updater": "^5.3.0",
    "electron-window-state": "^5.0.3",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "electron": "^26.6.10",
    "electron-builder": "~23.6.0",
    "electron-rebuild": "^3.2.9",
    "typescript": "^5.0.4"
  },
  "keywords": [
    "capacitor",
    "electron"
  ],
  "allowScripts": {
    "electron@26.6.10": true
  }
}
